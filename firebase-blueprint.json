{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["email", "createdAt"]
    },
    "DiaryEntry": {
      "title": "Diary Entry",
      "description": "A single entry in the parenting diary",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "date": {
          "type": "timestamp",
          "description": "The date of the diary entry"
        },
        "title": {
          "type": "string",
          "description": "Short title of the entry, max 200 chars"
        },
        "content": {
          "type": "string",
          "description": "Main body of the diary entry"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Base64 encoded image data or URL"
          }
        },
        "dateStr": {
          "type": "string",
          "description": "Date string"
        },
        "height": {
          "type": ["number", "null"]
        },
        "weight": {
          "type": ["number", "null"]
        },
        "breastMilkVolume": {
          "type": ["number", "null"]
        },
        "formulaVolume": {
          "type": ["number", "null"]
        },
        "formulaType": {
          "type": ["string", "null"]
        },
        "dirtyDiapers": {
          "type": ["number", "null"]
        },
        "wetDiapers": {
          "type": ["number", "null"]
        },
        "abnormalNotes": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["userId", "date", "title", "content", "images", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles,keyed by authentication UID."
    },
    "users/{userId}/diaryEntries/{entryId}": {
      "schema": {
        "$ref": "#/entities/DiaryEntry"
      },
      "description": "Diary entries belonging to a specific user."
    }
  }
}
